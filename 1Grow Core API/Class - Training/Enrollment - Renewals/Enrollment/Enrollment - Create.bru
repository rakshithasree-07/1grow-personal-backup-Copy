meta {
  name: Enrollment - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/enrollments
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "studentId": "{{studentId}}",
    "batchId": "{{batchId}}",
    "feePlanId": "{{feePlanId}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
