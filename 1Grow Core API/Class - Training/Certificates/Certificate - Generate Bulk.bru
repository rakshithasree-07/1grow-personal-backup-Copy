meta {
  name: Certificate - Generate Bulk
  type: http
  seq: 6
}

post {
  url: {{base-url}}/class/certificates/generate-bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "batchId": "00000000-0000-4000-8000-000000000002",
    "templateId": "00000000-0000-4000-8000-000000000011",
    "studentIds": ["00000000-0000-4000-8000-000000000005", "00000000-0000-4000-8000-000000000006"],
    "issuedDate": "2026-09-09"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}