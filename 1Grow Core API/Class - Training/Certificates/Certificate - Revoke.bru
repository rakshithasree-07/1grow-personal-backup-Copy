meta {
  name: Certificate - Revoke
  type: http
  seq: 8
}

post {
  url: {{base-url}}/class/certificates/{{id}}/revoke
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "reason": "Issued by mistake"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}