get {
  url: {{base-url}}/training/courses
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 10
  search: Bharatanatyam
  status: active
  sortBy: createdAt
  sortDir: DESC
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

