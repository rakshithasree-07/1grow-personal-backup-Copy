meta {
  name: Update
  type: http
  seq: 6
}

patch {
  url: {{base-url}}/training/courses/{{courseId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Dance class",
    "description": "Step, groove, and shine with our engaging dance classes",
    "thumbnailUrl": "https://cdn.example.com/dance-class-new.png"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

