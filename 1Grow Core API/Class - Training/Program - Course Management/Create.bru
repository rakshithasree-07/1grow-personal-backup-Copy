meta {
  name: Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/training/courses
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Yoga class",
    "type": "SHORT_TERM",
    "description": "Improve flexibility, strength, balance, and relaxation through guided yoga sessions."
    
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-success
  
  request: {
    url: {{base-url}}/training/courses
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Bharatanatyam Summer Camp",
        "type": "SHORT_TERM",
        "description": "An intensive summer camp featuring daily practice sessions and a final showcase",
        "startDate": "2026-07-10",
        "endDate": "2026-07-30",
        "fee": 5000
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
