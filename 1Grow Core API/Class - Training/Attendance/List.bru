meta {
  name: List
  type: http
  seq: 2
}

get {
  url: {{base-url}}/class/attendance
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 10
  batchId: {{batchId}}
  classSessionId: {{classSessionId}}
  dateFrom: 2026-09-01
  dateTo: 2026-09-30
  studentId: {{studentId}}
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
