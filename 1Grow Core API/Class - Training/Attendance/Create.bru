  Content-Type: application/json
}

body:json {
  {
    "batchId": "{{batchId}}",
    "classSessionId": "{{classSessionId}}",
    "date": "2026-09-09",
    "records": [
      { "studentId": "{{studentId}}", "status": "PRESENT", "remarks": "", "checkInTime": "09:15" },
      { "studentId": "{{studentId2}}", "status": "ABSENT", "remarks": "Medical leave", "checkInTime": "10:05" }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

