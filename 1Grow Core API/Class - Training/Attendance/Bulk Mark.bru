meta {
  name: Bulk Mark
  type: http
  seq: 6
}

post {
  url: {{base-url}}/class/attendance/bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "batchId": "{{batchId}}",
    "classSessionId": "{{classSessionId}}",
    "date": "2026-09-09",
    "defaultStatus": "PRESENT",
    "exceptions": [
      { "studentId": "{{studentId}}", "status": "ABSENT", "remarks": "Medical leave" }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
