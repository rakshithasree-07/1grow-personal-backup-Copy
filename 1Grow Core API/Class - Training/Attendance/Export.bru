meta {
  name: Export
  type: http
  seq: 9
}

get {
  url: {{base-url}}/class/attendance/export
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 20
  batchId: {{batchId}}
  classSessionId: {{classSessionId}}
  dateFrom: 2026-09-01
  dateTo: 2026-09-09
  studentId: {{studentId}}
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}
