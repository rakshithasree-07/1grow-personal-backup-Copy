meta {
  name: File - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/training/files
  body: multipart-form
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:multipart-form {
  file: <sample.pdf>
  category: TRAINING_MATERIAL
  originalName: sample.pdf
  mimeType: application/pdf
  size: 102400
}

settings {
  encodeUrl: true
  timeout: 0
}