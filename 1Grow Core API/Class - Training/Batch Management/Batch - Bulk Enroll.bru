meta {
  name: Batch - Bulk Enroll
  type: http
  seq: 17
}

post {
  url: {{base-url}}/training/batches/{{batchId}}/bulk-enroll
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "studentIds": [
      "{{studentId}}",
      "{{studentId2}}"
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
