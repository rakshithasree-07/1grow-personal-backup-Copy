meta {
  name: Batch - Add Schedule
  type: http
  seq: 21
}

post {
  url: {{base-url}}/training/batches/{{batchId}}/schedules
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "dayOfWeek": "MONDAY",
    "startTime": "09:00",
    "endTime": "10:30",
    "room": "Hall A"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
