meta {
  name: Batch - Update Status
  type: http
  seq: 6
}

patch {
  url: {{base-url}}/training/batches/{{batchId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "ACTIVE"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
