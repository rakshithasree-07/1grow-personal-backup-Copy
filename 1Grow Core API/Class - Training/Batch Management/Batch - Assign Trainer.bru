meta {
  name: Batch - Assign Trainer
  type: http
  seq: 10
}

post {
  url: {{base-url}}/training/batches/{{batchId}}/assign-trainer
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "trainerId": "00000000-0000-4000-8000-000000000004",
    "isPrimary": true
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
