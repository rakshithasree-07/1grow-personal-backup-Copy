meta {
  name: Calendar
  type: http
  seq: 3
}

get {
  url: {{base-url}}/training/schedules/calendar
  body: none
  auth: inherit
}

params:query {
  month: 7
  year: 2026
  batchId: {{batchId}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

settings {
  encodeUrl: true
  timeout: 0
}
