meta {
  name: List
  type: http
  seq: 2
}

get {
  url: {{base-url}}/training/schedules
  body: none
  auth: inherit
}

params:query {
  page: 1
  pageSize: 10
  batchId: {{batchId}}
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

script:post-response {
  const body = res.getBody();
  if (body.data && body.data.length > 0) {
    bru.setVar("sessionId", body.data[0].id);
    bru.setVar("classSessionId", body.data[0].id);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
