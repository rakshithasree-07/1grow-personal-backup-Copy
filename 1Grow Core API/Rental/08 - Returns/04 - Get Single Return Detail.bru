meta {
  name: 04 - Get Single Return Detail
  type: http
  seq: 4
}

get {
  url: {{base-url}}/rental/returns/{{createdReturnId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
}

