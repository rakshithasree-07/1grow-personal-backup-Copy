meta {
  name: 05 - Update Return Metadata
  type: http
  seq: 5
}

patch {
  url: {{base-url}}/rental/returns/{{createdReturnId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "notes": "Verified serial numbers against dispatch manifesto."
  }
}

assert {
  res.status: in [200, 201]
}

