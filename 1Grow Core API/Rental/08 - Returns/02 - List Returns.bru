meta {
  name: 02 - List Returns
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/returns?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const returns = res.body?.data?.returns || res.body?.data;
  if (Array.isArray(returns) && returns.length > 0) {
    bru.setVar('createdReturnId', returns[0].id);
    bru.setEnvVar('createdReturnId', returns[0].id);
  }
}

