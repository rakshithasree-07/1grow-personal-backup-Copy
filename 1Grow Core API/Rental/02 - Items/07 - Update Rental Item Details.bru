meta {
  name: 07 - Update Rental Item Details
  type: http
  seq: 6
}

patch {
  url: {{base-url}}/rental/items/{{createdItemId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "description": "Updated: Includes dual high-capacity batteries and card reader",
    "rentalPrice": 4800,
    "depositAmount": 6000
  }
}

assert {
  res.status: in [200, 201]
}

