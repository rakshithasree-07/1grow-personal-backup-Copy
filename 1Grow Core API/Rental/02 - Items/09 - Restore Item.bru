meta {
  name: 09 - Restore Item
  type: http
  seq: 8
}

post {
  url: {{base-url}}/rental/items/{{secondaryItemId}}/restore
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "notes": "Restored to active catalogue after maintenance checks"
  }
}

assert {
  res.status: in [200, 201]
}

