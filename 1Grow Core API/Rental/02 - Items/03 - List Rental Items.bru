meta {
  name: 03 - List Rental Items
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/items?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const items = res.body?.data?.items || res.body?.data;
  if (Array.isArray(items) && items.length > 0) {
    bru.setVar('createdItemId', items[0].id);
    bru.setEnvVar('createdItemId', items[0].id);
    if (items.length > 1) {
      bru.setVar('secondaryItemId', items[1].id);
      bru.setEnvVar('secondaryItemId', items[1].id);
    }
  }
}

