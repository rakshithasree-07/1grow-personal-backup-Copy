meta {
  name: 05 - Get Item Stats
  type: http
  seq: 4
}

get {
  url: {{base-url}}/rental/items/stats
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/rental/items/stats
    method: GET
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 5e705801-e47a-4cf1-ba32-9f39393c0226
      x-correlation-id: 5e705801-e47a-4cf1-ba32-9f39393c0226
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 273
      etag: W/"111-9HDXVZwipW8kLBspVHw40+oUNXk"
      date: Thu, 10 Sep 2026 16:30:32 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Rental item stats retrieved successfully",
          "timestamp": "2026-09-10T16:30:32.137Z",
          "data": {
            "totalItems": 4,
            "totalUnits": 18,
            "availableUnits": 18,
            "unavailableUnits": 0,
            "byStatus": {
              "AVAILABLE": 4,
              "RENTED": 0,
              "MAINTENANCE": 0,
              "DAMAGED": 0,
              "RETIRED": 0
            }
          }
        }
      '''
    }
  }
}

