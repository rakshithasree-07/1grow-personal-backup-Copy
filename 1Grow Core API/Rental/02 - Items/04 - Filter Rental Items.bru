meta {
  name: 04 - Filter Rental Items
  type: http
  seq: 3
}

get {
  url: {{base-url}}/rental/items?search=Sony&status=RENTED
  body: none
  auth: inherit
}

params:query {
  search: Sony
  status: RENTED
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
}

