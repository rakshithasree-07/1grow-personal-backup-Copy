meta {
  name: 02 - List Quotations
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/quotations?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const quotes = res.body?.data?.quotations || res.body?.data;
  if (Array.isArray(quotes) && quotes.length > 0) {
    bru.setVar('createdQuotationId', quotes[0].id);
    bru.setEnvVar('createdQuotationId', quotes[0].id);
  }
}

