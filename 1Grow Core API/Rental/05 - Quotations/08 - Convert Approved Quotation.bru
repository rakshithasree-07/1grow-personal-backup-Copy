meta {
  name: 08 - Convert Approved Quotation
  type: http
  seq: 8
}

post {
  url: {{base-url}}/rental/quotations/{{createdQuotationId}}/convert
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('quotationBookingId', res.body.data.id);
    bru.setEnvVar('quotationBookingId', res.body.data.id);
  }
}

