meta {
  name: 04 - Get Single Quotation Detail
  type: http
  seq: 4
}

get {
  url: {{base-url}}/rental/quotations/{{createdQuotationId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
}

