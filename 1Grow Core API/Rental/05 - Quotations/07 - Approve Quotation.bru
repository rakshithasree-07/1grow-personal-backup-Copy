meta {
  name: 07 - Approve Quotation
  type: http
  seq: 7
}

patch {
  url: {{base-url}}/rental/quotations/{{createdQuotationId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "APPROVED"
  }
}

assert {
  res.status: in [200, 201]
}

