meta {
  name: 06 - Send Quotation
  type: http
  seq: 6
}

post {
  url: {{base-url}}/rental/quotations/{{createdQuotationId}}/send
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: in [200, 201]
}

