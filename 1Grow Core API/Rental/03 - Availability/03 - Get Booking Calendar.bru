meta {
  name: 03 - Get Booking Calendar
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/bookings/calendar?startDate=2026-10-01&endDate=2026-12-31
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/rental/bookings/calendar?startDate=2026-10-01&endDate=2026-12-31
    method: GET
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  
