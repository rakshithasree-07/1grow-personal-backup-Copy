meta {
  name: 01 - Check Item Availability (Available)
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/items/check-availability
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "itemId": "{{createdItemId}}",
    "startDate": "2026-11-01",
    "endDate": "2026-11-05",
    "quantity": 2
  }
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data.isAvailable: eq true
}

