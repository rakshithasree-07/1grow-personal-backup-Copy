meta {
  name: 03 - Get Damage Stats
  type: http
  seq: 3
}

get {
  url: {{base-url}}/rental/damages/stats
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/rental/damages/stats
    method: GET
    mode: none
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 39fdd27d-0962-4fb0-a246-7cc7470afbfb
      x-correlation-id: 39fdd27d-0962-4fb0-a246-7cc7470afbfb
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 332
      etag: W/"14c-b05Y9rppeO5JEAgKYfoju9kgtVM"
      date: Fri, 11 Sep 2026 17:37:37 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Rental damage statistics retrieved successfully",
          "timestamp": "2026-09-11T17:37:37.840Z",
          "data": {
            "total": 1,
            "pendingAssessment": 1,
            "assessed": 0,
            "penaltyApplied": 0,
            "disputed": 0,
            "resolved": 0,
            "bySeverity": {
              "minor": 1,
              "moderate": 0,
              "major": 0,
              "totalLoss": 0
            },
            "totalDamagedUnits": 1,
            "totalPenaltyAmount": "2000"
          }
        }
