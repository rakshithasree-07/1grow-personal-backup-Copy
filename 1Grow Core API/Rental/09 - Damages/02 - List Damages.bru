meta {
  name: 02 - List Damages
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/damages?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const damages = res.body?.data?.damages || res.body?.data;
  if (Array.isArray(damages) && damages.length > 0) {
    bru.setVar('createdDamageId', damages[0].id);
    bru.setEnvVar('createdDamageId', damages[0].id);
  }
}

