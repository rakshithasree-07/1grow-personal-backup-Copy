meta {
  name: 01 - Create Damage Incident
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/damages
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "itemId": "{{createdItemId}}",
    "quantity": 1,
    "severity": "MINOR",
    "description": "Minor surface scuff on magnesium body shell",
    "penaltyAmount": 2000,
    "notes": "Mount and sensor completely unaffected. Optical performance nominal."
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('createdDamageId', res.body.data.id);
    bru.setEnvVar('createdDamageId', res.body.data.id);
  }
}

example {
  name: 201
  
  request: {
    url: {{base-url}}/rental/damages
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  
