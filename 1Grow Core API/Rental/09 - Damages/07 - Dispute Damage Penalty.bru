meta {
  name: 07 - Dispute Damage Penalty
  type: http
  seq: 7
}

patch {
  url: {{base-url}}/rental/damages/{{createdDamageId}}/dispute
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "notes": "Client requested waiver based on corporate tier agreement"
  }
}

assert {
  res.status: in [200, 201]
}

