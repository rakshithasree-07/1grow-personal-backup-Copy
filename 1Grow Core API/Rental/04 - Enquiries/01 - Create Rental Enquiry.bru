meta {
  name: 01 - Create Rental Enquiry
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/enquiries
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "customerName": "Karthik Media Productions",
    "phone": "+919840123456",
    "email": "karthik@mediapro.com",
    "itemId": "{{createdItemId}}",
    "quantity": 2,
    "eventDate": "2026-11-10",
    "eventEndDate": "2026-11-15",
    "requirements": "Feature film shoot in Chennai and Pondicherry",
    "source": "WALK_IN"
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('createdEnquiryId', res.body.data.id);
    bru.setEnvVar('createdEnquiryId', res.body.data.id);
  }
}

example {
  name: 201
  
  request: {
    url: {{base-url}}/rental/enquiries
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  
    body:json: {
      {
        "customerName": "Karthik Media Productions",
        "phone": "+919840123456",
        "email": "karthik@mediapro.com",
        "itemId": "{{createdItemId}}",
        "quantity": 2,
