meta {
  name: 02 - List Rental Enquiries
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/enquiries?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const enquiries = res.body?.data?.enquiries || res.body?.data?.items || res.body?.data;
  if (Array.isArray(enquiries) && enquiries.length > 0) {
    bru.setVar('createdEnquiryId', enquiries[0].id);
    bru.setEnvVar('createdEnquiryId', enquiries[0].id);
  }
}

