meta {
  name: 06 - Transition Status to CONTACTED
  type: http
  seq: 5
}

patch {
  url: {{base-url}}/rental/enquiries/{{createdEnquiryId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "CONTACTED",
    "notes": "Contacted director of photography. Confirmed camera kit specification."
  }
}

assert {
  res.status: in [200, 201]
}

