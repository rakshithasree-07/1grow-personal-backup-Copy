meta {
  name: 08 - Convert Enquiry to Booking
  type: http
  seq: 7
}

post {
  url: {{base-url}}/rental/enquiries/{{createdEnquiryId}}/convert
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "venue": "Mahabalipuram Outdoor Sets",
    "notes": "Converted from enquiry - feature film 5 day shoot"
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('convertedBookingId', res.body.data.id);
    bru.setEnvVar('convertedBookingId', res.body.data.id);
  }
}

