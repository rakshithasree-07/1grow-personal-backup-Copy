meta {
  name: 04 - Get Single Rental Enquiry
  type: http
  seq: 3
}

get {
  url: {{base-url}}/rental/enquiries/{{createdEnquiryId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

