meta {
  name: 01 - Create Direct Booking
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/bookings
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "customerName": "Aditya Walk-in Client",
    "phone": "+919123456780",
    "email": "aditya@walkin.com",
    "startDate": "2026-12-10",
    "endDate": "2026-12-12",
    "notes": "Weekend short film shoot",
    "items": [
      {
        "itemId": "{{createdItemId}}",
        "quantity": 1,
        "unitPrice": 4500
      }
    ]
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('directBookingId', res.body.data.id);
    bru.setEnvVar('directBookingId', res.body.data.id);
    bru.setVar('convertedBookingId', res.body.data.id);
    bru.setEnvVar('convertedBookingId', res.body.data.id);
  }
}

example {
  name: 201
  
  request: {
    url: {{base-url}}/rental/bookings
