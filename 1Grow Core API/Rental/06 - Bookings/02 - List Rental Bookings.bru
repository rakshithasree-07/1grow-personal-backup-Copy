meta {
  name: 02 - List Rental Bookings
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/bookings?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const bookings = res.body?.data?.bookings || res.body?.data?.items || res.body?.data;
  if (Array.isArray(bookings) && bookings.length > 0) {
    bru.setVar('convertedBookingId', bookings[0].id);
    bru.setEnvVar('convertedBookingId', bookings[0].id);
  }
}

