meta {
  name: 01 - Create Dispatch Intake (PENDING)
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/dispatches
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "bookingId": "{{convertedBookingId}}",
    "dispatchDate": "2026-11-16",
    "expectedReturn": "2026-11-15",
    "receivedBy": "Karthik Productions Logistics Team",
    "condition": "GOOD",
    "notes": "Pre-dispatch check complete. Packed in hard flight case."
  }
}

assert {
  res.status: in [200, 201]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('createdDispatchId', res.body.data.id);
    bru.setEnvVar('createdDispatchId', res.body.data.id);
  }
}

example {
  name: 201
  
  request: {
    url: {{base-url}}/rental/dispatches
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  
    body:json: {
      {
        "bookingId": "{{convertedBookingId}}",
        "dispatchDate": "2026-11-10",
