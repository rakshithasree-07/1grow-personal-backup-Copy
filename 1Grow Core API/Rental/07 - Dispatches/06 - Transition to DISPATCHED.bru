meta {
  name: 06 - Transition to DISPATCHED
  type: http
  seq: 5
}

patch {
  url: {{base-url}}/rental/dispatches/{{createdDispatchId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "status": "DISPATCHED"
  }
}

assert {
  res.status: in [200, 201]
}

