meta {
  name: 02 - List Categories
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/categories
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const list = res.body?.data;
  if (Array.isArray(list) && list.length > 0) {
    bru.setVar('createdCategoryId', list[0].id);
    bru.setEnvVar('createdCategoryId', list[0].id);
  }
}

