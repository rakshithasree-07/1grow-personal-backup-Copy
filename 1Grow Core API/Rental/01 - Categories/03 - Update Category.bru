meta {
  name: 03 - Update Category
  type: http
  seq: 3
}

patch {
  url: {{base-url}}/rental/categories/{{createdCategoryId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "description": "Updated: Comprehensive cine cameras, anamorphic lenses, and professional camera support"
  }
}

assert {
  res.status: in [200, 201]
}

