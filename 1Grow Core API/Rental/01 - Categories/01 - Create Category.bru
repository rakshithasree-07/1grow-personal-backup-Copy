meta {
  name: 01 - Create Category
  type: http
  seq: 1
}

post {
  url: {{base-url}}/rental/categories
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "name": "Cinema",
    "description": "Professional cinema line cameras and premium cine optics"
  }
}

assert {
  res.status: in [200, 201, 409]
}

script:post-response {
  if (res.body?.data?.id) {
    bru.setVar('createdCategoryId', res.body.data.id);
    bru.setEnvVar('createdCategoryId', res.body.data.id);
  }
}

example {
  name: 409
  
  request: {
    url: {{base-url}}/rental/categories
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{accessToken}}
    }
  
    body:json: {
      {
        "name": "Cinema & Optical Gear",
        "description": "Professional cinema line cameras and premium cine optics"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 099e542d-caad-4ce1-819f-97b3b6dffa11
      x-correlation-id: 099e542d-caad-4ce1-819f-97b3b6dffa11
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 149
      etag: W/"95-tZBvt9xmtuN2Fc0kC+OxZ98T09Q"
      date: Fri, 11 Sep 2026 16:55:34 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 409,
          "message": "Category 'Cinema & Optical Gear' already exists for this tenant",
          "data": null,
          "timestamp": "2026-09-11T16:55:34.221Z"
        }
      '''
    }
  }
}

