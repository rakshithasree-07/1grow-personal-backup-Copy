meta {
  name: 02 - List Maintenances
  type: http
  seq: 2
}

get {
  url: {{base-url}}/rental/maintenances?page=1&pageSize=10
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

assert {
  res.status: eq 200
  res.body.httpStatusCode: eq 200
  res.body.data: isDefined
}

script:post-response {
  const maintenances = res.body?.data?.maintenances || res.body?.data?.items || res.body?.data;
  if (Array.isArray(maintenances) && maintenances.length > 0) {
    bru.setVar('createdMaintenanceId', maintenances[0].id);
    bru.setEnvVar('createdMaintenanceId', maintenances[0].id);
  }
}

