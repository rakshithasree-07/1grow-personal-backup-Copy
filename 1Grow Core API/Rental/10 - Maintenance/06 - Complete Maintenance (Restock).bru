meta {
  name: 06 - Complete Maintenance (Restock)
  type: http
  seq: 6
}

post {
  url: {{base-url}}/rental/maintenances/{{createdMaintenanceId}}/complete
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{accessToken}}
}

body:json {
  {
    "repairedQty": 1,
    "cost": 2500,
    "notes": "Optical axis and sensor alignment certified. Restocked into active inventory."
  }
}

assert {
  res.status: in [200, 201]
}

