meta {
  name: Team - Bulk Assign Members
  type: http
  seq: 4
}

post {
  url: {{base-url}}/events/team/bulk
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
    "teamMembers": [
      {
        "userId": "user-uuid-1",
        "role": "COORDINATOR",
        "notes": "Main event coordinator"
      },
      {
        "userId": "user-uuid-2",
        "role": "SOUND_ENGINEER",
        "notes": "Responsible for sound setup and operation"
      },
      {
        "userId": "user-uuid-3",
        "role": "LIGHTING_TECHNICIAN",
        "notes": "Responsible for stage lighting"
      }
    ]
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## Audit logging
  Every successful assignment writes its own `CREATE` audit log for entity
  `EventTeamMember` (entityId = the new team member id).

  The request as a whole always writes one summary audit log for entity
  `EventTeamMember` with entityId `bulk`:

  ```json
  {
    "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
    "total": 3,
    "successful": 2,
    "failed": 1,
    "failures": [
      { "userId": "invalid-user-uuid", "role": "COORDINATOR", "error": "User not found" }
    ]
  }
  ```

  `failures` is only present when at least one member failed, so a fully failed
  request is still traceable in the audit log. View it under
  `Security > Audit Logs` filtered by entity `EventTeamMember`.
}

