            "total": 3,
            "successful": 3,
            "failed": 0,
            "results": [
              {
                "success": true,
                "userId": "user-uuid-1",
                "role": "COORDINATOR"
              },
              {
                "success": true,
                "userId": "user-uuid-2",
                "role": "SOUND_ENGINEER"
              },
              {
                "success": true,
                "userId": "user-uuid-3",
                "role": "LIGHTING_TECHNICIAN"
              }
            ]
          },
          "timestamp": "2026-09-06T14:48:09.197Z"
        }
      '''
    }
  }
}

example {
  name: 400-Error-UserNotFound
  
  request: {
    url: {{base-url}}/events/team/bulk
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
        "teamMembers": [
          {
            "userId": "invalid-user-uuid",
            "role": "COORDINATOR",
            "notes": "Main event coordinator"
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "Bulk assignment completed: 0 successful, 1 failed",
          "data": {
            "total": 1,
            "successful": 0,
            "failed": 1,
            "results": [
              {
                "success": false,
                "userId": "invalid-user-uuid",
                "role": "COORDINATOR",
                "error": "User not found"
              }
            ]
          },
          "timestamp": "2026-09-06T14:48:09.197Z"
        }
      '''
    }
  }
}

example {
  name: 400-Error-OverAllocation
  
  request: {
    url: {{base-url}}/events/team/bulk
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
        "teamMembers": [
          {
            "userId": "user-uuid-1",
            "role": "COORDINATOR",
            "notes": "Already assigned to 5 active events"
          }
        ]
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "Bulk assignment completed: 0 successful, 1 failed",
          "data": {
            "total": 1,
            "successful": 0,
            "failed": 1,
            "results": [
              {
                "success": false,
                "userId": "user-uuid-1",
                "role": "COORDINATOR",
                "error": "User is already assigned to 5 active events. Maximum allowed is 5."
              }
            ]
          },
          "timestamp": "2026-09-06T14:48:09.197Z"
        }
      '''
    }
  }
}
