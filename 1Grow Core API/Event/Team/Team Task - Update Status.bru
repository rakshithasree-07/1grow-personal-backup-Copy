meta {
  name: Team Task - Update Status
  type: http
  seq: 9
}

patch {
  url: {{base-url}}/events/{{eventId}}/team/{{memberIdP}}/tasks/{{taskId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "IN_PROGRESS"//TODO,IN_PROGRESS,REVIEW,COMPLETED,BLOCKED,CANCELLED
    "notifyClient": true
  }
}

vars:pre-request {
  eventId: 97330d56-033e-4e25-b834-88bf255049d2
  memberIdP: 1c1a3f2e-7d84-4f6a-9b25-6f0c2d4e8a11
  taskId: 486b5d62-3c6e-4e9d-a61f-7562f031ecc7
}

settings {
  encodeUrl: true
  timeout: 0
}
