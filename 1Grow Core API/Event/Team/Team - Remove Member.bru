meta {
  name: Team - Update Member Status
  type: http
  seq: 3
}

patch {
  url: {{base-url}}/events/{{eventId}}/team/{{memberIdP}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "ACTIVE"//'ACTIVE' | 'INACTIVE' | 'AVAILABLE' | 'ASSIGNED' | 'UNAVAILABLE' | 'DECLINED' | 'COMPLETED
  }44214085-5fc7-40eb-9e51-dcfe3a3695ab
}

