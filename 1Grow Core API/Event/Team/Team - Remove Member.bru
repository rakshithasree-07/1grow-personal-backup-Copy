  eventId: 97330d56-033e-4e25-b834-88bf255049d2
  memberIdP: 44214085-5fc7-40eb-9e51-dcfe3a3695ab
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Success-Inactive
  
  request: {
    url: {{base-url}}/events/{{eventId}}/team/{{memberIdP}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "status": "INACTIVE"
      }
    }
  }
  
  response: {
