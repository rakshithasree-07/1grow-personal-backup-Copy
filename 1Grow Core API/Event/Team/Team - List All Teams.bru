meta {
  name: Team - List All Teams
  type: http
  seq: 1
}

get {
  url: {{base-url}}/events/team
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

