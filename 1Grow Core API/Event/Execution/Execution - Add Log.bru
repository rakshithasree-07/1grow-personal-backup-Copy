meta {
  name: Execution - Add Log
  type: http
  seq: 1
}

post {
  url: {{base-url}}/events/{{eventId}}/execution
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "SETUP",
    "notes": "Event setup started, sound system installation in progress",
    "photos": ["https://example.com/photo1.jpg", "https://example.com/photo2.jpg"]
  }
}

vars:pre-request {
  eventId: f1c54043-ea31-4b03-b282-3a65de389f66
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Success
  
  request: {
    url: {{base-url}}/events/{{eventId}}/execution
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "status": "IN_PROGRESS",
        "notes": "Event setup started, sound system installation in progress",
        "photos": ["https://example.com/photo1.jpg", "https://example.com/photo2.jpg"]
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 40d9a4c1-6638-4ed5-a2d0-9fe3f89053ee
      x-correlation-id: 40d9a4c1-6638-4ed5-a2d0-9fe3f89053ee
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 118
      x-ratelimit-reset: 48
      content-type: application/json; charset=utf-8
      content-length: 584
      etag: W/"248-8iZsDpdCLaj0KBsfqk26KKG9cNc"
      date: Mon, 07 Sep 2026 15:45:10 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 201,
          "message": "Execution log added successfully",
          "data": {
            "id": "93cae746-3f11-40e0-a833-ac5143848b18",
            "tenantId": "12bf3d33-1f28-4ec2-b2d7-17a8534e87f3",
            "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
            "userId": "1b6136f2-0269-496b-9671-e69d69d35d97",
            "status": "IN_PROGRESS",
            "notes": "Event setup started, sound system installation in progress",
            "photos": [
              "https://example.com/photo1.jpg",
              "https://example.com/photo2.jpg"
            ],
            "createdAt": "2026-09-07T15:45:10.071Z",
            "user": {
              "id": "1b6136f2-0269-496b-9671-e69d69d35d97",
              "name": "Lavanya"
            }
          },
          "timestamp": "2026-09-07T15:45:10.324Z"
        }
      '''
    }
  }
}

example {
  name: 400-Error
  
  request: {
    url: {{base-url}}/events/{{eventId}}/execution
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "status": "SETUP",
        "notes": "Event setup started, sound system installation in progress",
        "photos": ["https://example.com/photo1.jpg", "https://example.com/photo2.jpg"]
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 38595917-5adb-4c94-be4e-f11b52ee4ca9
      x-correlation-id: 38595917-5adb-4c94-be4e-f11b52ee4ca9
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 117
      x-ratelimit-reset: 58
      content-type: application/json; charset=utf-8
      content-length: 162
      etag: W/"a2-YESgnbd3iwpIg8XD7uTrKG7Qf3o"
      date: Mon, 07 Sep 2026 16:04:43 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "An execution log with similar status and notes already exists for this event",
          "data": null,
          "timestamp": "2026-09-07T16:04:43.875Z"
