meta {
  name: Type - Update Status
  type: http
  seq: 4
}

patch {
  url: {{base-url}}/events/types/{{typeId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "isActive": true
  }
}

vars:pre-request {
  typeId: 531c955a-b700-472c-9b13-ea1f662b382c
}

script:pre-request {
  const axios = require("axios");
  
  if (!bru.getVar("typeId") && !bru.getEnvVar("typeId")) {
    const baseUrl = bru.getEnvVar("base-url") || bru.getVar("base-url");
    const token = bru.getEnvVar("token") || bru.getVar("token");
  
    try {
      const res = await axios.get(`${baseUrl}/events/types?page=1&pageSize=1`, {
        headers: {
          Authorization: `Bearer ${token}`
        }
      });
  
      if (res.data && res.data.data && Array.isArray(res.data.data) && res.data.data.length > 0) {
        bru.setVar("typeId", res.data.data[0].id);
      } else {
        console.error("No event types found to fetch.");
      }
    } catch (err) {
      console.error("Failed to fetch event types:", err.message);
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Success
  
  request: {
    url: {{base-url}}/events/types/{{typeId}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "isActive": false
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: feca375d-8ad0-4afc-be9a-1b3d5c76fa79
      x-correlation-id: feca375d-8ad0-4afc-be9a-1b3d5c76fa79
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 118
      x-ratelimit-reset: 35
      content-type: application/json; charset=utf-8
      content-length: 123
      etag: W/"7b-CmqsYYj2WQqkY+qqbMvZEMzo8H0"
      date: Mon, 07 Sep 2026 08:54:18 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Event type status updated to INACTIVE",
          "data": null,
          "timestamp": "2026-09-07T08:54:18.228Z"
        }
      '''
    }
  }
}
