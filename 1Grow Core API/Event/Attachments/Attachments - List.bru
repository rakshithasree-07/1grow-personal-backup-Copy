meta {
  name: Attachments - List
  type: http
  seq: 2
}

get {
  url: {{base-url}}/attachments?eventId={{eventId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  eventId: 97330d56-033e-4e25-b834-88bf255049d2
}

settings {
  encodeUrl: true
  timeout: 0
}

