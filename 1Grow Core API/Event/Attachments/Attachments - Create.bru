meta {
  name: Attachments - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/attachments
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "type": "document",
    "url": "https://exadddddxdsdmple.com/documents/event-brochure.pdf",
    "eventId": "{{event-Id}}",
    "mimeType": "application/pdf",
    "filename": "event-brochure.pdf",
    "size": 2450000
  }
}

vars:pre-request {
  event-Id: ce5e1198-a09f-4bbb-ba2f-e61f19586c77
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Created
  
  request: {
    url: {{base-url}}/attachments
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "type": "document",
        "url": "https://example.com/documents/event-brochure.pdf",
        "eventId": "d7947fb6-a3f9-4766-a4ec-b336b7201e7e"
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      access-control-allow-credentials: true
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Attachment added successfully",
          "data": {
            "id": "0f9c2d3e-8b4a-4c6f-9d1e-2a3b4c5d6e7f",
            "type": "document",
            "url": "https://example.com/documents/event-brochure.pdf"
          }
        }
      '''
    }
  }
}

example {
  name: 409- Duplicate
  
  request: {
    url: {{base-url}}/attachments
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "type": "document",
        "url": "https://example.com/documents/event-brochure.pdf",
        "eventId": "d7947fb6-a3f9-4766-a4ec-b336b7201e7e"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 664a77f2-062f-4f39-9954-f699f2b81d93
      x-correlation-id: 664a77f2-062f-4f39-9954-f699f2b81d93
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 111
      etag: W/"6f-VR5bfraXN/xoyuqnH/AXYvlPuXU"
      date: Sun, 06 Sep 2026 11:13:22 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 409,
          "message": "Attachment already exists",
          "data": null,
          "timestamp": "2026-09-06T11:13:22.279Z"
        }
      '''
    }
  }
}
