meta {
  name: Attachments - Deactivate
  type: http
  seq: 6
}

patch {
  url: {{base-url}}/attachments/{{attachmentId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "isActive": false
  }
}

vars:pre-request {
  attachmentId: 0c49894f-f4a0-443e-81a6-6eb4f3d964be
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Deactivated
  
  request: {
    url: {{base-url}}/attachments/{{attachmentId}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "isActive": false
      }
    }
  }
  
  response: {
    headers: {
      content-type: application/json; charset=utf-8
      access-control-allow-credentials: true
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Attachment deactivated successfully",
          "data": null
        }
      '''
    }
  }
}

