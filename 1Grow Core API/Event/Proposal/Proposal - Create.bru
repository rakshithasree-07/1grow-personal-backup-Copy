meta {
  name: Proposal - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/events/proposals
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "eventId": "aef632ca-5941-42e9-8fe4-c77ff8e67229",
    "clientId": "41eebfdf-b662-441a-977c-47a2af81dc9f",
    "title": "Cultural Event Proposal - Annual Day",
    "shortSummary": "Complete event management and production support for the annual cultural day celebration.",
    "scope": "Full event management including sound, lighting, stage setup, and artist coordination",
    "dateAndTime": {
      "eventDate": "2026-04-20",
      "startTime": "17:00",
      "endTime": "22:00"
    },
    "targetAudience": "Students, staff and parents of the institution (approx 1200 attendees)",
    "servicePlanning": [
      {
        "serviceId": "9a41f5cd-6219-41ea-b5e0-6c0ec4bd551b"
      },
      {
        "serviceId": "037b30b4-22b5-4acd-8e52-6fbd036c0309"
      }
    ],
    "includes": ["Sound system", "Stage lighting", "LED backdrop", "Event coordinator"],
    "excludes": ["Catering", "Transportation"],
    "pricing": {
      "subtotal": 320000,
      "discount": 10000,
      "tax": 40000,
      "additionalCharges": 0,
      "totalAmount": 350000,
      "currency": "INR"
    },
    "totalAmount": 350000,
    "paymentTerms": "30% advance at booking, 70% balance after event",
    "budgetValidUntil": "2026-04-30",
    "termsConditions": [
      "Payment due before event date",
      "Catering and transportation excluded",
      "Logistics and cleanup by venue"
    ],
    "companyLogo": {
      "url": "https://example.com/logo.png",
      "altText": "Company logo"
    },
    "notes": "Proposal valid for 30 days",
    "status": "DRAFT"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

