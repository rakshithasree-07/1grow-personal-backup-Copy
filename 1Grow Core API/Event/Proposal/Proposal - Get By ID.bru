meta {
  name: Proposal - Get By ID
  type: http
  seq: 3
}

get {
  url: {{base-url}}/events/proposals/{{proposalId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  proposalId: 234561d1-02af-4207-8ef7-bfa475038304
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## Response Example
  The proposal includes the resolved service information:
  ```json
  {
    "message": "Proposal retrieved successfully",
    "data": {
      "id": "proposal-uuid",
      "proposalNumber": "PROP-2026-0001",
      "title": "Cultural Event Proposal - Annual Day",
      "shortSummary": "Complete event management and production support for the annual cultural day celebration.",
      "scope": "Full event management including sound, lighting, stage setup, and artist coordination",
      "dateAndTime": {
        "eventDate": "2026-04-20",
        "startTime": "17:00",
        "endTime": "22:00"
      },
      "targetAudience": "Students, staff and parents of the institution (approx 1200 attendees)",
      "servicePlanning": [
        {
          "service": "Sound System",
          "serviceId": "service-uuid",
          "description": "Full sound system with backup for main stage",
          "quantity": 1,
          "unit": "event",
          "unitPrice": 150000,
          "isActive": true
        },
        {
          "service": "Stage Lighting",
          "serviceId": "service-uuid",
          "description": "Stage lighting with color effects for performances",
          "quantity": 1,
          "unit": "event",
          "unitPrice": 170000,
          "isActive": true
        }
      ],
      "includes": ["Sound system", "Stage lighting", "LED backdrop", "Event coordinator"],
      "excludes": ["Catering", "Transportation"],
      "pricing": {
        "subtotal": 320000,
        "discount": 10000,
        "tax": 40000,
        "additionalCharges": 0,
        "totalAmount": 350000,
        "currency": "INR"
      },
      "totalAmount": 350000,
      "paymentTerms": "30% advance at booking, 70% balance after event",
      "budgetValidUntil": "2026-04-30",
      "termsConditions": [
        "Payment due before event date",
        "Catering and transportation excluded",
        "Logistics and cleanup by venue"
      ],
      "companyLogo": {
        "url": "https://example.com/logo.png",
        "altText": "Company logo"
      },
      "notes": "Proposal valid for 30 days",
      "status": "DRAFT",
      "event": {
        "id": "event-uuid",
        "eventNumber": "EVT-2026-0001",
        "title": "Annual Day Cultural Event"
      },
      "client": {
        "id": "client-uuid",
        "name": "ABC Institution",
        "phone": "9876543210",
        "companyName": "ABC Educational Trust"
      }
    }
  }
  ```
}

example {
  name: 200-success
  
  request: {
    url: {{base-url}}/events/proposals/{{proposalId}}
    method: GET
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }
  
    body:json: {
      }
              
      auth:inherit {
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: b593c90e-0245-4179-90d8-85a018898ab8
      x-correlation-id: b593c90e-0245-4179-90d8-85a018898ab8
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      etag: W/"ab8-qZffeylMTCQs8R4L/4uh/4iCZIc"
      date: Sat, 05 Sep 2026 15:06:38 GMT
      connection: keep-alive
      keep-alive: timeout=5
      transfer-encoding: chunked
    }
  
    status: {
      code: 200
      text: OK
