}

patch {
  url: {{base-url}}/events/proposals/{{proposalId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "title": "Cultural Event Proposal - Updated",
    "shortSummary": "Updated summary for the annual cultural day event.",
    "scope": "Updated scope with additional services",
    "dateAndTime": {
      "eventDate": "2026-05-01",
      "startTime": "17:00",
      "endTime": "22:00"
    },
    "targetAudience": "Students, staff and parents (approx 1400 attendees)",
    "servicePlanning": [
      {
        "serviceId": "service-uuid"
      }
    ],
    "includes": ["Sound system", "Stage lighting", "LED backdrop", "Event coordinator"],
    "excludes": ["Catering", "Transportation"],
    "pricing": {
      "subtotal": 370000,
      "discount": 10000,
      "tax": 45000,
      "additionalCharges": 5000,
      "totalAmount": 410000,
      "currency": "INR"
    },
    "totalAmount": 400000,
    "paymentTerms": "30% advance at booking, 70% balance after event",
    "budgetValidUntil": "2026-05-15",
    "termsConditions": [
      "Payment due before event date",
      "Catering and transportation excluded"
    ],
    "notes": "Updated proposal with revised pricing"
  }
}

