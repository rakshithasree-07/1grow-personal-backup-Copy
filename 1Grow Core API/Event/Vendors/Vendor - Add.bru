meta {
  name: Vendor - Add
  type: http
  seq: 1
}

post {
  url: {{base-url}}/vendors
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "vendorName": "Sound Masterrs Co",
    "vendorType": "Sound & Lighting",
    "contactName": "Kumar",
    "phone": "9876545320",
    "email": "kumar@soundmasters.com",
    "services": ["47f65416-c78a-4324-a853-80917e42d2eb"],
    "gstin": "33ABCDE1234F1Z5",
    "address": {
      "addressLine1": "123 Main Road",
      "city": "Chennai",
      "state": "Tamil Nadu",
      "postalCode": "600001",
      "country": "India"
    },
    "paymentTerms": {
      "type": "ADVANCE",
      "percentage": 50
    },
    "notes": "Premium sound setup",
    "isActive": true
  }
}

script:post-response {
  const body = res.getBody();
  if (body.data && body.data.id) {
    bru.setVar("vendorId", body.data.id);
  } else {
    console.error("Vendor Create failed:", body.message || "Unknown error");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

