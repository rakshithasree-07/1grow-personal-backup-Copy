meta {
  name: Client - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/events/clients
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "leadId": "146cb887-c13b-4699-a303-0f66c955db80",
    "name": "Ravi Kumar",
    "phone": "9788583045",
    "email": "ravi024@enterprises.com",
    "companyName": "Ravi Enterprises Pvt Ltd",
    "numberOfBranches": 3,
    "gstNumber": "33AAACR1234F1Z5",
    "panNumber": "AAACR12314F",
    "designation": "Managing Director",
    "preferredCommunication": "Email",
    "street": "456 Business Paris",
    "city": "Chennai",
    "state": "Tamil Nadu",
    "country": "India",
    "notes": "Business Type: Private Limited"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## leadId is optional
  `leadId` is **optional**. Omit it and supply `name`, `phone` and `email` instead.
  When `leadId` is sent it must be a UUID belonging to the same tenant, and any
  missing `name` / `phone` / `email` is auto-filled from the lead. The link can
  only be set at creation time - `Client - Update` does not accept `leadId`.
  See the `success` and `example` examples below for requests without a `leadId`.
}

example {
  name: success
  
  request: {
    url: {{base-url}}/events/clients
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "name": "Ravi Kumar",
        "phone": "9876543210",
        "email": "ravi@enterprises.com",
        "companyName": "Ravi Enterprises Pvt Ltd",
        "numberOfBranches": 3,
        "gstNumber": "33AAACR1234F1Z5",
        "panNumber": "AAACR1234F",
        "designation": "Managing Director",
        "preferredCommunication": "Email",
        "street": "456 Business Park, Chennai - 600001",
        "city": "Chennai",
