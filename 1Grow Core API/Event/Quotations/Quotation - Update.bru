        "discount": 0,
        "taxRate": 18,
        "total": 38000
      }
    ],
    "subtotal": 75000,
    "discount": {
      "type": "FIXED",
      "amount": 3000
    },
    "tax": {
      "type": "GST",
      "rate": 18,
      "amount": 13500
