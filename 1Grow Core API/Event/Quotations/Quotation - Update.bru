meta {
  name: Quotation - Update
  type: http
  seq: 4
}

patch {
  url: {{base-url}}/events/quotations/{{quotationId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
