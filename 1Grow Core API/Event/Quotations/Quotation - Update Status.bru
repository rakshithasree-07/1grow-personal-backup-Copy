meta {
  name: Quotation - Update Status
  type: http
  seq: 5
}

patch {
  url: {{base-url}}/events/quotations/{{quotationId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "DRAFT"//SENT,APPROVED,REJECTED,EXPRIED
  }
}

