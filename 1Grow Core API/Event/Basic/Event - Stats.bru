      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 0fe6148e-05fd-4a20-9182-ab93b36a9a6d
      x-correlation-id: 0fe6148e-05fd-4a20-9182-ab93b36a9a6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 118
      x-ratelimit-reset: 44
      content-type: application/json; charset=utf-8
      content-length: 250
      etag: W/"fa-1l9Ov9vrygqUfm1NvTVjDfV6ELc"
      date: Tue, 01 Sep 2026 16:08:17 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Event stats retrieved successfully",
          "data": {
            "total": 2,
            "draft": 0,
            "proposalSent": 0,
            "proposalApproved": 0,
            "quotationSent": 0,
            "confirmed": 0,
            "inProgress": 0,
            "completed": 0,
            "cancelled": 0
          },
          "timestamp": "2026-09-03T10:00:17.692Z"
        }
      '''
    }
  }
}

