meta {
  name: Event - Create
  type: http
  seq: 1
}

post {
  url: {{base-url}}/events
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  // thumbnailImage can be a URL link or a direct image link
  // attachments is an optional array of attachment ids; the id is returned by the API
  //   (e.g. brochures, contracts, reference documents)
  // eventType / branch / services accept objects whose "id" is resolved to
  // show the full details (name/city for branch, service details, type details)
  // branch is OPTIONAL - if omitted (or the id is empty/invalid) the event is created without a branch
  {
    "title": "Cuulteural mass Celebration 2026",
    "description": "Mass cultural event",
    "thumbnailImage": "https://example.com/images/annual-day.jpg",
    "attachments": [
      "0f9c2d3e-8b4a-4c6f-9d1e-2a3b4c5d6e7f",
      "1a2b3c4d-5e6f-4a7b-8c9d-0e1f2a3b4c5d"
    ],
    "eventType": {
      "id": "851838ec-c0d6-4b0d-9de4-8ecadc799e6a"
    },
    "services": [
      { }
    ]
  }
}

script:post-response {
  const body = res.getBody();
  if (body && body.message === "Event created successfully") {
    console.log("Event created successfully");
  } else {
    console.error("Event Create failed:", body.message || "Unknown error");
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: Success
  
  request: {
    url: {{base-url}}/events
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "title": "Annual Day Celebration 2026",
        "description": "School annual day cultural event",
        "thumbnailImage": "https://example.com/images/annual-day.jpg",
        "attachments": [
          "3f7cb8a2-1c4e-4b5a-9d6f-2a9c8d7e6b5a"
        ],
        "eventType": {
          "id": "f30799ec-c45a-47a5-9173-c2ce3a8edc19"
        },
        "services": [
          { "id": "service-uuid-1" },
          { "id": "service-uuid-2" }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 201,
          "message": "Event created successfully",
          "data": null,
          "timestamp": "2026-09-02T10:00:00.000Z"
        }
      '''
    }
  }
}

