meta {
  name: Event - Get By ID
  type: http
  seq: 4
}

get {
  url: {{base-url}}/events/{{eventId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  eventId: 4bd83e46-e759-4117-8336-cae92dbed13e
}

settings {
  encodeUrl: true
  timeout: 0
}

