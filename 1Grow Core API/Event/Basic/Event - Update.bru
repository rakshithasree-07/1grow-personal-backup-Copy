example {
  name: 200-Removed attachments
  
  request: {
    url: {{base-url}}/events/{{eventId}}
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "attachments": []
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Event updated successfully",
          "data": null
        }
      '''
    }
  }
