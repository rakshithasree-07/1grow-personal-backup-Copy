}

example {
  name: 400-StartAfterEnd
  meta: {
    name: 400-StartAfterEnd
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "startTime": "2026-03-15T10:00:00.000Z"
        "endTime": "2026-03-15T09:00:00.000Z"
        "title": "Invalid Slot"
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "startTime must be before endTime",
          "error": "Bad Request",
          "timestamp": "2026-09-09T10:00:00.000Z"
        }
      '''
    }
  }
}
