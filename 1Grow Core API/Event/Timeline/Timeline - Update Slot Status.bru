meta {
  name: Timeline - Update Slot Status
  type: http
  seq: 5
}

patch {
  url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "isActive": false
  }
}

vars:pre-request {
  eventId: 4bd83e46-e759-4117-8336-cae92dbed13e
  slotId: 0016db5a-f516-4c77-95dd-46b9b03aa619
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Deactivated
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "isActive": false
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Timeline slot deactivated",
          "data": {
            "slotId": "43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e",
            "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
            "title": "Stage Setup",
            "isActive": false,
            "dependencies": [
              {
                "slotId": "a8d2f1c4-2e6b-4f7a-9c1d-5e6a8b9c0d1e",
                "title": "Sound System Setup"
              }
            ],
            "taskId": "486b5d62-3c6e-4e9d-a61f-7562f031ecc7",
            "createdAt": "2026-09-09T10:05:00.000Z",
            "updatedAt": "2026-09-09T10:12:00.000Z"
          },
          "timestamp": "2026-09-09T10:12:00.000Z"
        }
      '''
    }
  }
}

example {
  name: 200-Reactivated
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "isActive": true
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Timeline slot activated",
          "data": {
            "slotId": "43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e",
            "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
            "title": "Stage Setup",
            "isActive": true,
            "dependencies": [
              {
                "slotId": "a8d2f1c4-2e6b-4f7a-9c1d-5e6a8b9c0d1e",
                "title": "Sound System Setup"
              }
            ],
            "taskId": "486b5d62-3c6e-4e9d-a61f-7562f031ecc7",
            "createdAt": "2026-09-09T10:05:00.000Z",
            "updatedAt": "2026-09-09T10:15:00.000Z"
          },
          "timestamp": "2026-09-09T10:15:00.000Z"
        }
      '''
    }
  }
}
