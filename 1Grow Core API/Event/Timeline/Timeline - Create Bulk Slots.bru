example {
  name: 400-InvalidSlotTime
  meta: {
    name: 400-InvalidSlotTime
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/bulk
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "slots": [
          {
            "startTime": "2026-05-15T10:00:00.000Z",
            "endTime": "2026-05-15T09:00:00.000Z",
            "title": "Invalid Slot"
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "startTime must be before endTime in slot \"Invalid Slot\"",
          "error": "Bad Request",
          "timestamp": "2026-09-10T15:30:00.000Z"
        }
      '''
    }
  }
}

