example {
  name: 400-EmptySlotsArray
  meta: {
    name: 400-EmptySlotsArray
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/bulk
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "slots": []
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "slots must contain at least one timeline slot",
          "error": "Bad Request",
          "timestamp": "2026-09-27T15:30:00.000Z"
        }
      '''
    }
  }
}

example {
  name: 400-InvalidUserId
  meta: {
    name: 400-InvalidUserId
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/bulk
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "slots": [
          {
            "startTime": "2026-05-15T09:00:00.000Z",
            "endTime": "2026-05-15T10:00:00.000Z",
            "title": "Test Slot",
            "assignedTo": [
              {
                "userId": "invalid-user-id-not-uuid",
                "role": "SETUP_TEAM"
              }
            ]
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "each value in assignedTo must be a UUID",
          "error": "Bad Request",
          "timestamp": "2026-09-10T15:30:00.000Z"
        }
      '''
    }
  }
}
