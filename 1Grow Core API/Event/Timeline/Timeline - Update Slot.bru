example {
  name: 409-ScheduleConflict
  meta: {
    name: 409-ScheduleConflict
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "startTime": "2026-03-15T10:30:00.000Z",
        "endTime": "2026-03-15T12:00:00.000Z"
      }
    }
  }
  
  response: {
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 409,
          "message": "Schedule conflict with existing slot(s): \"Sound System Setup\"",
          "error": "Conflict",
          "timestamp": "2026-09-09T10:10:00.000Z"
        }
      '''
    }
  }
}
