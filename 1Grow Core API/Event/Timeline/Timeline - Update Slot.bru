meta {
  name: Timeline - Update Slot
  type: http
  seq: 4
}

patch {
  url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "startTime": "2026-03-15T09:30:00.000Z",
    "endTime": "2026-03-15T10:30:00.000Z",
    "title": "Stage Setup and Decoration",
    "description": "Complete stage structure and decoration",
    "priority": "HIGH",
    "dependencies": [],
    "assignedTo": [
      {
        "userId": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
        "role": "SETUP_TEAM"
      },
      {
        "userId": "another-user-uuid-here",
        "role": "DECORATOR"
      }
    ]
  }
}

vars:pre-request {
  eventId: 460e138d-d11c-4e6b-a65e-570b093ec809
  slotId: 43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ## Linking and unlinking a task
  `taskId` is **optional**. Send a task id of the same event to link it, or
  `null` to unlink the current task:

  ```json
  { "taskId": "a345c6a2-8ca6-4fa7-86c1-ace49f2caf31" }
  { "taskId": null }
  ```

  A task from another event is rejected with
  `One or more taskIds do not exist or do not belong to this event`.
  Omitting `taskId` entirely leaves the current link untouched.
}

example {
  name: 200-Success
  meta: {
    name: 200-Success
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "title": "Stage Setup and Decoration",
        "description": "Complete stage structure and decoration",
        "priority": "HIGH",
        "assignedTo": [
          {
            "userId": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
            "role": "SETUP_TEAM"
          }
        ]
      }
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Timeline slot updated successfully",
          "data": {
            "slotId": "43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e",
            "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
            "title": "Stage Setup and Decoration",
            "description": "Complete stage structure and decoration",
            "startTime": "2026-03-15T09:30:00.000Z",
            "endTime": "2026-03-15T10:30:00.000Z",
            "priority": "HIGH",
            "isActive": true,
            "isMilestone": false,
            "dependencies": [
              {
                "slotId": "43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e",
                "title": "Stage Setup"
              }
            ],
            "taskId": "486b5d62-3c6e-4e9d-a61f-7562f031ecc7",
            "assignees": [
              {
                "id": "assignee-id-1",
                "userId": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
                "role": "SETUP_TEAM",
                "user": {
                  "id": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
                  "name": "John Doe",
                  "email": "john@example.com",
                  "phone": "9876543210"
                }
              }
            ],
            "createdAt": "2026-09-09T10:05:00.000Z",
            "updatedAt": "2026-09-09T10:10:00.000Z"
          },
          "timestamp": "2026-09-09T10:10:00.000Z"
        }
      '''
    }
  }
}

