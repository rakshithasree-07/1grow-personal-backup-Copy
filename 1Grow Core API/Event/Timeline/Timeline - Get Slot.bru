meta {
  name: Timeline - Get Slot
  type: http
  seq: 3
}

get {
  url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

vars:pre-request {
  eventId: 460e138d-d11c-4e6b-a65e-570b093ec809
  slotId: 43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Success
  meta: {
    name: 200-Success
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
    method: GET
    mode: none
    headers: {
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Timeline slot retrieved successfully",
          "data": {
            "slotId": "43075c6e-5b4d-4e8a-a87c-7c8c1f3b9a2e",
            "eventId": "460e138d-d11c-4e6b-a65e-570b093ec809",
            "title": "Stage Setup",
            "description": "Complete the stage structure and decoration setup",
            "startTime": "2026-03-15T09:00:00.000Z",
            "endTime": "2026-03-15T10:00:00.000Z",
            "priority": "HIGH",
            "isMilestone": false,
            "dependencies": [],
            "taskId": "486b5d62-3c6e-4e9d-a61f-7562f031ecc7",
            "assignees": [
              {
                "id": "assignee-id-1",
                "userId": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
                "role": "SETUP_TEAM",
                "user": {
                  "id": "63a2ee91-c0a9-4ce7-88ec-17e3037946d5",
                  "name": "John Doe",
                  "email": "john@example.com",
                  "phone": "9876543210"
                }
              }
            ],
            "createdAt": "2026-09-09T10:00:00.000Z",
            "updatedAt": "2026-09-09T10:00:00.000Z"
          },
          "timestamp": "2026-09-09T10:00:00.000Z"
        }
      '''
    }
  }
}

