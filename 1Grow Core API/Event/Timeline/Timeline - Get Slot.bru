example {
  name: 404-NotFound
  meta: {
    name: 404-NotFound
    enabled: true
  }
  
  request: {
    url: {{base-url}}/events/{{eventId}}/timeline/{{slotId}}
    method: GET
    mode: none
    headers: {
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    status: {
      code: 404
      text: Not Found
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 404,
          "message": "Timeline slot not found",
          "error": "Not Found",
          "timestamp": "2026-09-09T10:00:00.000Z"
        }
      '''
    }
  }
}
