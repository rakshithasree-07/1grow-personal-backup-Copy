meta {
  name: Task - Update Status
  type: http
  seq: 4
}

patch {
  url: {{base-url}}/events/{{eventId}}/tasks/{{taskId}}/status
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "status": "COMPLETED",//TODO,IN_PROGRESS,REVIEW,COMPLETED,BLOCKED,CANCELLED,
    "notifyClient": true
  }
}

vars:pre-request {
  eventId: 4bd83e46-e759-4117-8336-cae92dbed13e
  taskId: a345c6a2-8ca6-4fa7-86c1-ace49f2caf31
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200-Success
  
  request: {
    url: {{base-url}}/events/{{eventId}}/tasks/{{taskId}}/status
    method: PATCH
    mode: json
    headers: {
      Authorization: Bearer {{token}}
      Content-Type: application/json
    }
  
    body:json: {
      {
        "status": "IN_PROGRESS"//TODO,IN_PROGRESS,REVIEW,COMPLETED,BLOCKED,CANCELLED,
        "notifyClient": false
      }
    }
