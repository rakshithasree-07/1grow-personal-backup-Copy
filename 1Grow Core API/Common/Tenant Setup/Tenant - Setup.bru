meta {
  name: Tenant - Setup
  type: http
  seq: 2
}

post {
  url: {{base-url}}/onboarding/tenant
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "businessName": "Kalai Arangam Academy",
    "businessType": "TRAINING",
    "legalName": "Kalai Arangam Academy Private Ltd",
    "tagline": "Learn. Create. Perform.",
    "description": "A premier performing arts academy.",
    "logo": "https://res.cloudinary.com/dcvyai79m/image/upload/v1/logo/academy.png",
    "coverImage": "https://res.cloudinary.com/dcvyai79m/image/upload/v1/logo/cover.jpg",
    "phone": "9876543210",
    "email": "contact@kalaiarangam.com",
    "whatsapp": "9876543210",
    "website": "https://kalaiarangam.com",
    "gstin": "33ABCDE1234F1Z5",
    "pan": "ABCDE1234F",
    "msmeUdyamNumber": "UDYAM-TN-05-0001234",
    "invoicePrefix": "KA",
    "taxEnabled": true,
    "taxPercentage": 18,
    "primaryColor": "#6366F1",
    "secondaryColor": "#F97316",
    "addressLine1": "12, Anna Salai",
    "addressLine2": "Guindy",
    "city": "Chennai",
    "district": "Chennai",
    "state": "Tamil Nadu",
    "country": "India",
    "pincode": "600001",
    "latitude": 13.0827,
    "longitude": 80.2707,
    "businessHours": {
      "mon": "09:00-18:00",
      "tue": "09:00-18:00",
      "sat": "09:00-14:00"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Success

  request: {
    url: {{base-url}}/onboarding/tenant
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "businessName": "Kalai Arangam Academy",
        "businessType": "TRAINING",
        "phone": "9876543210",
        "email": "contact@kalaiarangam.com",
        "addressLine1": "12, Anna Salai",
        "city": "Chennai",
        "state": "Tamil Nadu",
        "pincode": "600001"
      }
    }
  }

  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      x-correlation-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 800
      etag: W/"320-xxxx"
      date: Tue, 01 Sep 2026 19:20:00 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Business created successfully with head office and trial subscription",
          "data": {
            "tenant": {
              "id": "185d41a4-0abf-4829-80f2-f298e4405135",
              "name": "Kalai Arangam Academy",
              "slug": "kalai-arangam-academy",
              "code": "KALA-AB12"
            },
            "headOffice": {
              "id": "c3d45678-9abc-4def-8123-456789abcdef",
              "name": "Head Office"
            },
            "subscription": {
              "status": "TRIAL",
              "trialDays": 15
            },
            "token": {
              "accessToken": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.token",
              "user": {
                "id": "cb1003d5-3d8a-4e89-98fd-8eb68922329f",
                "tenantId": "185d41a4-0abf-4829-80f2-f298e4405135",
                "branchId": null,
                "email": "owner@test.com",
                "name": "Karthikeyan",
                "role": "OWNER",
                "status": "ACTIVE",
                "industries": ["TRAINING"]
              }
            },
            "redirectTo": "/owner/dashboard"
          },
          "timestamp": "2026-09-01T19:20:00.123Z"
        }
      '''
    }
  }
}

example {
  name: 409 Business name already registered

  request: {
    url: {{base-url}}/onboarding/tenant
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "businessName": "Kalai Arangam Academy",
        "businessType": "TRAINING"
      }
    }
  }

  response: {
    status: {
      code: 409
      text: Conflict
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 409,
          "message": "Business name is already registered",
          "data": null,
          "timestamp": "2026-09-01T19:20:00.123Z"
        }
      '''
    }
  }
}