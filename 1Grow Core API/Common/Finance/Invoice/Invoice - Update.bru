meta {
  name: Invoice - Update
  type: http
  seq: 9
}

patch {
  url: {{base-url}}/invoices/{{id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "description": "Updated - Bharatanatyam Monthly Fee (with discount)",
