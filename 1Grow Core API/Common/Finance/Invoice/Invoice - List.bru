meta {
  name: Invoice - List
  type: http
  seq: 3
}

get {
  url: {{base-url}}/invoices
  body: none
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

params:query {
  page: 1
  pageSize: 20
  search: 
  status: 
  studentId: 
  clientId: 
  dateFrom: 
  dateTo: 
  sortBy: createdAt
  sortDir: desc
}

docs {
  ━━━ Search by client name ━━━

  GET /invoices?search=ravi&clientId=7a1c2e3f-9b4d-4f5a-9c1e-2d4f6a8b0c12

  ━━━ Filter student invoices ━━━

  GET /invoices?studentId=4b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e&status=pending

