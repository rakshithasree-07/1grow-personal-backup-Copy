meta {
  name: Category - Update
  type: http
  seq: 3
}

patch {
  url: {{base-url}}/finance/expense-categories/{{id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
  Content-Type: application/json
}

body:json {
  {
    "name": "Office & Stationery",
    "code": "OFFICE",
    "description": "Stationery, printing, and general office purchases (updated)",
    "isActive": true
  }
}

docs {
  ━━━ REQUEST PAYLOAD ━━━

  {
    "name":        "Office & Stationery",  // optional (2-100 chars, unique per tenant)
    "code":        "OFFICE",               // optional
    "description": "...",                  // optional
    "isActive":    true                    // optional
  }

  Only provided fields are updated. Renaming to an existing name in the
  same tenant → 400.


  ━━━ SUCCESS ━━━

  {
    "message": "Expense category updated successfully",
    "data": {
      "id": "c1a2b3c4-5d6e-7f8a-9b0c-1d2e3f4a5b6c",
      "tenantId": "t1a2b3c4-5d6e-7f8a-9b0c",
      "name": "Office & Stationery",
      "code": "OFFICE",
      "description": "Stationery, printing, and general office purchases (updated)",
      "isActive": true,
      "createdAt": "2026-09-03T09:00:00.000Z",
      "updatedAt": "2026-09-03T10:00:00.000Z"
    }
  }


  ━━━ ERROR RESPONSES ━━━

  404 — Category not found (or not in this tenant):

  {
    "message": "Expense category not found",
    "data": null
  }

  400 — Duplicate name:

  {
    "message": "An expense category with this name already exists",
    "data": null
  }

  400 — Validation failed (bad field type):

  {
    "message": "Validation failed",
    "data": [
      { "property": "isActive", "message": ["isActive must be a boolean value"] }
    ]
  }

  401 — Unauthorized:

  {
    "message": "Unauthorized",
    "data": null
  }

  403 — Forbidden:

  {
    "message": "Forbidden resource",
    "data": null
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
