meta {
  name: Search Payees
  type: http
  seq: 1
}

get {
  url: {{base-url}}/billing/payees/search
  body: none
  auth: inherit
}

params:query {
  search: ravi
  limit: 10
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ━━━ Search by phone ━━━
  
  GET /billing/payees/search?search=98765
  
  ━━━ Sample Response ━━━
  
  {
    "message": "Payees retrieved",
    "data": {
      "clients": [
        {
          "id": "7a1c2e3f-9b4d-4f5a-9c1e-2d4f6a8b0c12",
          "name": "Ravi Kumar",
          "phone": "9876543210",
          "email": "ravi@example.com",
          "type": "CLIENT"
        }
      ],
      "students": [
        {
          "id": "4b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e",
          "name": "Ravi Sharma",
          "phone": "9876543211",
          "email": "ravi.sharma@example.com",
          "type": "STUDENT"
        }
      ]
    }
  }
  
  ━━━ No results ━━━
  
  {
    "message": "Payees retrieved",
    "data": {
      "clients": [],
      "students": []
    }
  }
}

example {
  name: 200
  
  request: {
    url: {{base-url}}/billing/payees/search
    method: GET
    mode: none
    params:query: {
      search: ravi
      limit: 10
    }
  
    headers: {
      Authorization: Bearer {{token}}
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 0fb22f2c-0041-4c97-9a6b-ed826dc5934f
      x-correlation-id: 0fb22f2c-0041-4c97-9a6b-ed826dc5934f
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 109
      etag: W/"6d-F0KwVL7kvojF2gF8zwMv4bcUsrk"
      date: Thu, 03 Sep 2026 10:43:29 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
