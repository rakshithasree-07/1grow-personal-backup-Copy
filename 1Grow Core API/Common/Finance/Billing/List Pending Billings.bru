meta {
  name: List Pending Billings
  type: http
  seq: 1
}

get {
  url: {{base-url}}/billing/pending
  body: none
  auth: inherit
}

params:query {
  page: 1
  limit: 20
  search: 
  status: 
  clientId: 
  studentId: 
}

headers {
  Authorization: Bearer {{token}}
}

settings {
  encodeUrl: true
  timeout: 0
}

docs {
  ━━━ Search by client name ━━━
  
  GET /billing/pending?search=ravi
  
  ━━━ Filter by student ━━━
  
  GET /billing/pending?studentId=4b2c3d4e&status=PENDING
  
