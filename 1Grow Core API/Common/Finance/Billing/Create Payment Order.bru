meta {
  name: Create Payment Order
  type: http
  seq: 1
}

post {
  url: {{base-url}}/billing/payments/orders
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "paymentType": "STUDENT_FEE",
    "invoiceId": "{{invoiceId}}",
    "clientId": "{{clientId}}",
    "studentId": "{{studentId}}",
    "description": "Course fee payment - Java Full Stack",
    "metadata": {
      "source": "web"
    }
  }
}

docs {
  ━━━ Sample Response ━━━

  {
    "message": "Payment order created",
    "data": {
      "paymentOrder": {
        "id": "a1b2c3d4-5e6f-7a8b-9c0d-1e2f3a4b5c6d",
        "amount": 50000,
        "currency": "INR",
        "status": "PENDING",
        "paymentType": "STUDENT_FEE",
        "description": "Course fee payment - Java Full Stack",
        "invoiceId": "c2d3e4f5-6a7b-8c9d-0e1f-2a3b4c5d6e7f",
        "installmentId": null,
        "clientId": null,
        "studentId": "4b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e",
        "createdAt": "2026-09-03T10:30:00.000Z"
      },
      "razorpayOrder": {
        "id": "order_xxxxxxxxxxxx",
        "amount": 5000000,
        "currency": "INR",
        "receipt": "rcpt_xxxxxxxx_1234567890",
        "status": "CREATED"
      },
      "keyId": "rzp_live_xxxxxxxxxxxx"
    }
  }

  ━━━ Without Invoice (Direct Payment) ━━━

  {
    "paymentType": "CLIENT_PAYMENT",
    "clientId": "7a1c2e3f-9b4d-4f5a-9c1e-2d4f6a8b0c12",
    "amountOverridePaise": 1000000,
    "description": "Event booking advance"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
