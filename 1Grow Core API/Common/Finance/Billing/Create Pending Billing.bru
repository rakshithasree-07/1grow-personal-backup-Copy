meta {
  name: Create Pending Billing
  type: http
  seq: 1
}

post {
  url: {{base-url}}/billing/pending
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "amount": 5000,
    "clientId": "{{clientId}}",
    "description": "Event booking balance payment",
    "dueDate": "2026-10-15",
    "metadata": {
      "source": "event_booking",
      "eventId": "{{eventId}}"
    }
  }
}

docs {
  ━━━ Student Billing ━━━

  {
    "amount": 15000,
    "studentId": "{{studentId}}",
    "description": "Annual exam fee",
    "dueDate": "2026-12-01"
  }

