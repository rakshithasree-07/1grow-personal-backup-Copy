meta {
  name: Record Manual Payment
  type: http
  seq: 6
}

post {
  url: {{base-url}}/billing/payments/manual
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "invoiceId": "{{invoiceId}}",
    "clientId": "{{clientId}}",
    "studentId": "{{studentId}}",
    "amount": 5000,
    "paymentMode": "CASH",
    "reference": "CHQ-001234",
    "description": "Cash payment received for monthly fee"
  }
}

docs {
  ━━━ Sample Response ━━━

  {
    "message": "Manual payment recorded",
    "data": {
      "paymentOrder": {
        "id": "d4e5f6a7-8b9c-0d1e-2f3a-4b5c6d7e8f9a",
        "status": "SUCCESS",
        "amount": 5000,
        "clientId": "7a1c2e3f-9b4d-4f5a-9c1e-2d4f6a8b0c12",
        "studentId": "4b2c3d4e-5f6a-7b8c-9d0e-1f2a3b4c5d6e"
      },
      "transaction": {
        "id": "e5f6a7b8-9c0d-1e2f-3a4b-5c6d7e8f9a0b",
        "mode": "CASH",
        "reference": "CHQ-001234"
      },
      "invoice": {
        "id": "c2d3e4f5-6a7b-8c9d-0e1f-2a3b4c5d6e7f",
        "invoiceNumber": "INV-abc123-1725360600000",
        "paidAmount": 5000,
        "status": "PARTIALLY_PAID"
      }
    }
  }

  ━━━ Without Invoice (Direct Client Payment) ━━━

  {
    "clientId": "7a1c2e3f-9b4d-4f5a-9c1e-2d4f6a8b0c12",
    "amount": 10000,
    "paymentMode": "BANK_TRANSFER",
    "reference": "NEFT-REF-2026",
    "description": "Client payment for rental service"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
