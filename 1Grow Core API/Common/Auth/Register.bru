meta {
  name: Register
  type: http
  seq: 2
}

post {
  url: {{base-url}}/auth/register
  body: json
  auth: none
}

body:json {
  {
    "name": "Demo 1",
    "email": "abi.cbe.dev2@gmail.com",
    "phone": "9200000012",
    "password": "Demo@123"
   // "role": "OWNER"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 409 Email already exists
  
  request: {
    url: {{base-url}}/auth/register
    method: POST
    mode: json
    body:json: {
      {
        "name": "Demo 1",
        "email": "abi.cbe.dev@gmail.com",
        "phone": "9000000001",
        "password": "Demo@123"
       // "role": "OWNER"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: e5118795-b7cf-49e1-bf83-67710ee9b30c
      x-correlation-id: e5118795-b7cf-49e1-bf83-67710ee9b30c
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 106
      etag: W/"6a-re5zDdyEKUVaAv6UHujWivOK6rE"
      date: Tue, 01 Sep 2026 04:15:36 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 409
      text: Conflict
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 409,
          "message": "Email already exists",
          "data": null,
          "timestamp": "2026-09-01T04:15:36.855Z"
        }
      '''
    }
  }
}

