meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: {{base-url}}/auth/login
  body: json
  auth: none
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "type": "email",
    "email": "owner@test.com",
  //   "type": "phone",
  //   "phone":"9000000001",
    "password": "Demo@123",
    "rememberMe": true
  }
}

vars:post-response {
  accessToken: data.accessToken
  refreshToken: data.refreshToken
}

script:post-response {
  const body = res.getBody();
  if (body.data) {
    bru.setVar("token", body.data.accessToken);
    bru.setVar("refreshToken", body.data.refreshToken);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Sucess
  description: login with both mail and phone number
  
  request: {
    url: {{base-url}}/auth/login
    method: POST
    mode: json
    headers: {
      Content-Type: application/json
    }
  
    body:json: {
      {
        // "type": "email",
        // "email": "owner@test.com",
        "type": "phone",
        "phone":"9000000001",
        "password": "Demo@123",
        "rememberMe": true
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 75d49cde-65cb-4c0b-a025-0fb0637c8589
      x-correlation-id: 75d49cde-65cb-4c0b-a025-0fb0637c8589
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 5
      x-ratelimit-remaining: 3
      x-ratelimit-reset: 3438
      content-type: application/json; charset=utf-8
      etag: W/"5d6-btvaKdWTLXlyKgni0P98nLKL5rw"
      date: Tue, 01 Sep 2026 04:09:16 GMT
      connection: keep-alive
      keep-alive: timeout=5
      transfer-encoding: chunked
    }
  
    status: {
      code: 201
      text: Created
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 201,
          "message": "Login successful",
          "data": {
            "user": {
              "id": "cb1003d5-3d8a-4e89-98fd-8eb68922329f",
