meta {
  name: Reset Password
  type: http
  seq: 6
}

post {
  url: {{base-url}}/auth/reset-password
  body: json
  auth: none
}

body:json {
  {
    //"email": "abi.cbe.dev@gmail.com",
    "token": "2c1c2c866867df2b69066bcba6eb00f8f580d383b6c25da7adc418f2281fa83c",
    "newPassword": "Demo@123"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Password changed
  
  request: {
    url: {{base-url}}/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        //"email": "abi.cbe.dev@gmail.com",
        "token": "2c1c2c866867df2b69066bcba6eb00f8f580d383b6c25da7adc418f2281fa83c",
        "newPassword": "Demo@123"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 9eb70ed8-5e13-4419-9d59-dab421bf01de
      x-correlation-id: 9eb70ed8-5e13-4419-9d59-dab421bf01de
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 10
      x-ratelimit-remaining: 9
      x-ratelimit-reset: 3600
      content-type: application/json; charset=utf-8
      content-length: 128
      etag: W/"80-+1oXVOEWEvt0U8A/aWjuOLaWkFo"
      date: Tue, 01 Sep 2026 16:14:21 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Success",
          "data": {
            "message": "Password reset successful"
          },
          "timestamp": "2026-09-01T16:14:21.429Z"
        }
      '''
    }
  }
}

example {
  name: 400 Invalid token
  
  request: {
    url: {{base-url}}/auth/reset-password
    method: POST
    mode: json
    body:json: {
      {
        //"email": "abi.cbe.dev@gmail.com",
        "token": "2c1c2c866867df2b69066bcba6eb00f8f580d383b6c25da7adc418f2281fa83c",
        "newPassword": "Demo@123"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 3c32e5c6-ae1c-455a-a691-4f4fbc1d266c
      x-correlation-id: 3c32e5c6-ae1c-455a-a691-4f4fbc1d266c
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 10
      x-ratelimit-remaining: 8
      x-ratelimit-reset: 3581
      content-type: application/json; charset=utf-8
      content-length: 99
      etag: W/"63-90qjG3Yps4/zJHRW82kZbtmTMGU"
      date: Tue, 01 Sep 2026 16:14:39 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "Invalid token",
          "data": null,
          "timestamp": "2026-09-01T16:14:39.900Z"
        }
      '''
