meta {
  name: Change Password
  type: http
  seq: 9
}

post {
  url: {{base-url}}/auth/change-password
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "currentPassword": "Demo@123",
    "newPassword": "Demo@1234"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 400 Same pass
  
  request: {
    url: {{base-url}}/auth/change-password
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }
  
    body:json: {
      {
        "currentPassword": "Demo@123",
        "newPassword": "Demo@123"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: e87798f8-5a4d-43f2-8026-cc4e9a1abb6a
      x-correlation-id: e87798f8-5a4d-43f2-8026-cc4e9a1abb6a
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 142
      etag: W/"8e-lV3kJW89Mb5eXUZhvyBFyXnJqMI"
      date: Tue, 01 Sep 2026 17:09:41 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 400
      text: Bad Request
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "New password must be different from the current password",
          "data": null,
          "timestamp": "2026-09-01T17:09:41.049Z"
        }
      '''
    }
  }
}

