meta {
  name: Set Password
  type: http
  seq: 8
}

post {
  url: {{base-url}}/auth/set-password
  body: json
  auth: none
}

body:json {
  {
    "token": "{{invite-token}}",
    "newPassword": "Demo@123"
  }
}

vars:pre-request {
  invite-token: 06bccd902743680b580d9404da6bc09ed44c107166f2c2e646b51e1bce5cffb2
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Success
  
  request: {
    url: {{base-url}}/auth/set-password
    method: POST
    mode: json
    body:json: {
      {
        "token": "eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJzdWIiOiJmNDczYTY5ZS1hYmNkLTEyMzQtc2V0LXBhc3N3b3JkIiwiaWF0IjoxNzg4MjM2NTk0LCJleHAiOjE3ODg4NDEzOTR9.invite-token-sample",
        "newPassword": "Password@123"
      }
    }
  }
  
  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      x-correlation-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 150
      etag: W/"96-xxxx"
      date: Tue, 01 Sep 2026 17:20:00 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }
  
    status: {
      code: 200
      text: OK
    }
  
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Password set successfully. You can now log in.",
          "data": null,
          "timestamp": "2026-09-01T17:20:00.123Z"
        }
      '''
    }
  }
}

example {
