meta {
  name: Logout
  type: http
  seq: 11
}

post {
  url: {{base-url}}/auth/logout
  body: json
  auth: none
}

body:json {
  {
    "refreshToken": "{{refreshToken}}"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

