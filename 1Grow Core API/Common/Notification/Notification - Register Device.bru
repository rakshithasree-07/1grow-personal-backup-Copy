meta {
  name: Notification - Register Device
  type: http
  seq: 8
}

post {
  url: {{base-url}}/notification/register-device
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "deviceToken": "fcm-token",
    "platform": "android"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

