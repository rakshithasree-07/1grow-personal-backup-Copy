meta {
  name: Lead - Update
  type: http
  seq: 7
}

patch {
  url: {{base-url}}/leads/{{id}}
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "module": "TRAINING",
    "courseId": "{{courseId}}",
    "studentId": "{{studentId}}",
    "status": "CONTACTED",
    "notes": "Called and shared course details"
  }
}

example {
  name: success

  response: {
    status: { code: 200, text: OK }
    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Lead updated successfully",
          "data": {
            "id": "lead-uuid",
            "module": "TRAINING",
            "courseId": "{{courseId}}",
            "studentId": "{{studentId}}",
            "courseProgram": { "id": "{{courseId}}", "name": "Java Full Stack", "type": "SHORT_TERM" },
            "student": { "id": "{{studentId}}", "name": "Ravi Kumar", "phone": "9876543210", "isActive": true },
            "status": "CONTACTED"
          }
        }
      '''
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
