meta {
  name: Invite Owner
  type: http
  seq: 8
}

post {
  url: {{base-url}}/onboarding/invite-owner
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "email": "owner@example.com",
    "name": "Owner Name"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
