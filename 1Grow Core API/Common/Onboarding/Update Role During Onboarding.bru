meta {
  name: Update Role During Onboarding
  type: http
  seq: 16
}

post {
  url: {{base-url}}/onboarding/role/update
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "role": "STAFF"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Success

  request: {
    url: {{base-url}}/onboarding/role/update
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "role": "STAFF"
      }
    }
  }

  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      x-correlation-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 320
      etag: W/"140-xxxx"
      date: Tue, 02 Sep 2026 11:30:00 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Role updated to STAFF",
          "data": {
            "role": "STAFF",
            "previousRole": "OWNER",
            "currentStep": "ORG_SEARCH"
          },
          "timestamp": "2026-09-02T11:30:00.123Z"
        }
      '''
    }
  }
}

example {
  name: 400 Onboarding already completed

  request: {
    url: {{base-url}}/onboarding/role/update
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "role": "STAFF"
      }
    }
  }

  response: {
    status: {
      code: 400
      text: Bad Request
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 400,
          "message": "Onboarding is already completed. Role can no longer be changed through onboarding.",
          "data": null,
          "timestamp": "2026-09-02T11:30:00.123Z"
        }
      '''
    }
  }
}