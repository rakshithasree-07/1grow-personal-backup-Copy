meta {
  name: Approve Access Request
  type: http
  seq: 11
}

post {
  url: {{base-url}}/onboarding/access-requests/approve
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "accessRequestId": "access-request-uuid"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
