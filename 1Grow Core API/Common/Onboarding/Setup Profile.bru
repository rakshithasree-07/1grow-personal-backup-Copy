meta {
  name: Setup Profile
  type: http
  seq: 4
}

post {
  url: {{base-url}}/onboarding/profile
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "fullName": "John Doe",
    "mobileNumber": "9876543210",
    "whatsappNumber": "9876543210",
    "profilePhoto": "https://res.cloudinary.com/dcvyai79m/image/upload/v1/profile/avatar.jpg",
    "dateOfBirth": "1995-06-15",
    "gender": "male",
    "addressLine1": "12, Nungambakkam High Road",
    "city": "Chennai",
    "district": "Chennai",
    "state": "Tamil Nadu",
    "country": "India",
    "pincode": "600001",
    "emergencyName": "Jane Doe",
    "emergencyPhone": "9876543211",
    "emergencyRelation": "Spouse"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Success

  request: {
    url: {{base-url}}/onboarding/profile
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "fullName": "John Doe",
        "mobileNumber": "9876543210",
        "whatsappNumber": "9876543210",
        "profilePhoto": "https://res.cloudinary.com/dcvyai79m/image/upload/v1/profile/avatar.jpg",
        "dateOfBirth": "1995-06-15",
        "gender": "male",
        "city": "Chennai",
        "state": "Tamil Nadu",
        "country": "India",
        "pincode": "600001"
      }
    }
  }

  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      x-correlation-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 700
      etag: W/"2bc-xxxx"
      date: Tue, 01 Sep 2026 19:10:00 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Profile setup completed",
          "data": {
            "nextStep": "TENANT_SETUP",
            "profile": {
              "fullName": "John Doe",
              "mobileNumber": "9876543210",
              "whatsappNumber": "9876543210",
              "profileUrl": "https://res.cloudinary.com/dcvyai79m/image/upload/v1/profile/avatar.jpg",
              "dateOfBirth": "1995-06-15",
              "gender": "male",
              "addressLine1": null,
              "addressLine2": null,
              "city": "Chennai",
              "district": null,
              "state": "Tamil Nadu",
              "country": "India",
              "pincode": "600001",
              "emergencyName": null,
              "emergencyPhone": null,
              "emergencyRelation": null
            }
          },
          "timestamp": "2026-09-01T19:10:00.123Z"
        }
      '''
    }
  }
}

example {
  name: 200 CLIENT completed

  request: {
    url: {{base-url}}/onboarding/profile
    method: POST
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "fullName": "Client Name"
      }
    }
  }

  response: {
    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "Profile setup completed. Onboarding finished.",
          "data": {
            "nextStep": "COMPLETED",
            "completed": true,
            "redirectTo": "/client/dashboard",
            "profile": {
              "fullName": "Client Name",
              "profileUrl": null
            }
          },
          "timestamp": "2026-09-01T19:10:00.123Z"
        }
      '''
    }
  }
}