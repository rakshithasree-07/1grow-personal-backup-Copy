meta {
  name: RBAC - Update User Role (Super Admin)
  type: http
  seq: 16
}

put {
  url: {{base-url}}/rbac/super-admin/users/{{id}}/role
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "role": "BRANCH_MANAGER"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

example {
  name: 200 Success (after onboarding completed)

  request: {
    url: {{base-url}}/rbac/super-admin/users/{{id}}/role
    method: PUT
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "role": "BRANCH_MANAGER"
      }
    }
  }

  response: {
    headers: {
      content-security-policy: default-src 'self';base-uri 'self';font-src 'self' https: data:;form-action 'self';frame-ancestors 'self';img-src 'self' data:;object-src 'none';script-src 'self';script-src-attr 'none';style-src 'self' https: 'unsafe-inline';upgrade-insecure-requests
      cross-origin-opener-policy: same-origin
      cross-origin-resource-policy: same-origin
      origin-agent-cluster: ?1
      referrer-policy: no-referrer
      strict-transport-security: max-age=31536000; includeSubDomains
      x-content-type-options: nosniff
      x-dns-prefetch-control: off
      x-download-options: noopen
      x-frame-options: SAMEORIGIN
      x-permitted-cross-domain-policies: none
      x-xss-protection: 0
      x-request-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      x-correlation-id: 1a2b3c4d-5e6f-7a8b-9c0d-1e2f3a4b5c6d
      vary: Origin, Accept-Encoding
      access-control-allow-credentials: true
      x-ratelimit-limit: 120
      x-ratelimit-remaining: 119
      x-ratelimit-reset: 60
      content-type: application/json; charset=utf-8
      content-length: 320
      etag: W/"140-xxxx"
      date: Tue, 02 Sep 2026 11:35:00 GMT
      connection: keep-alive
      keep-alive: timeout=5
    }

    status: {
      code: 200
      text: OK
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 200,
          "message": "User role updated to BRANCH_MANAGER",
          "data": {
            "id": "f473a69e-1fff-4251-80bc-4cc9cc061391",
            "name": "Demo Staff",
            "email": "staff@test.com",
            "role": "BRANCH_MANAGER",
            "status": "ACTIVE",
            "emailVerified": true,
            "updatedAt": "2026-09-02T11:35:00.123Z"
          },
          "timestamp": "2026-09-02T11:35:00.123Z"
        }
      '''
    }
  }
}

example {
  name: 403 Forbidden (non super admin)

  request: {
    url: {{base-url}}/rbac/super-admin/users/{{id}}/role
    method: PUT
    mode: json
    headers: {
      Authorization: Bearer {{token}}
    }

    body:json: {
      {
        "role": "BRANCH_MANAGER"
      }
    }
  }

  response: {
    status: {
      code: 403
      text: Forbidden
    }

    body: {
      type: json
      content: '''
        {
          "httpStatusCode": 403,
          "message": "Forbidden resource",
          "data": null,
          "timestamp": "2026-09-02T11:35:00.123Z"
        }
      '''
    }
  }
}