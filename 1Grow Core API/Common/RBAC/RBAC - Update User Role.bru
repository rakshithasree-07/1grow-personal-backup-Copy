meta {
  name: RBAC - Update User Role
  type: http
  seq: 14
}

put {
  url: {{base-url}}/rbac/users/{{id}}/role
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "role": "BRANCH_MANAGER",
    "branchId": "branch-uuid"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

