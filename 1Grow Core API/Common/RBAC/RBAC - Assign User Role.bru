meta {
  name: RBAC - Assign User Role
  type: http
  seq: 6
}

post {
  url: {{base-url}}/rbac/user-roles
  body: json
  auth: inherit
}

headers {
  Authorization: Bearer {{token}}
}

body:json {
  {
    "userId": "user-uuid",
    "role": "STAFF",
    "branchId": "branch-uuid"
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

