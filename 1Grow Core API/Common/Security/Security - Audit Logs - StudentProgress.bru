meta {
  name: Security - Audit Logs - StudentProgress
  type: http
  seq: 22
}

get {
  url: {{base-url}}/security/audit-logs
  body: none
  auth: inherit
}

docs {
  # StudentProgress audit records

  Filtered view of the audit trail for the `StudentProgress` entity.

  **Roles:** `SUPER_ADMIN`, `OWNER`, `BRANCH_MANAGER`

  ## Written by

  `POST /class/progress`, `PATCH /class/progress/:id`, `POST /class/progress/recalculate`

  Recalculation logs one `UPDATE` with `entityId` = `recalculate:<count>` (or the single progress id when only one enrollment is affected). `oldValues.records` and `newValues.records` carry up to 50 per-student rows of `{ progressId, studentId, percentage }` and `{ created, oldPercentage, newPercentage }`; `created`, `updated` and `omittedRecords` break the run down. `omittedRecords` is non-zero when the run touched more than 50 students, in which case the diff is a prefix and not the whole run.

  Recalculation is a `POST` that does not create a resource of its own, so
  filter on `action: UPDATE` and not on a mutation of `StudentProgress` when
  reconciling the trail.

  `entity` is an exact, case-insensitive match, so every returned row is a
  genuine `StudentProgress` record. Use `entityContains` for the old partial
  behaviour, or see `Security - Audit Logs - Class Module` for all seven Class
  entities in one request.
}

headers {
  Authorization: Bearer {{token}}
}

query {
  page: 1
  pageSize: 100
  entity: StudentProgress
}

assert {
  res.status: eq 200
  res.body.message: eq "Audit logs fetched"
}

script:post-response {
  const ENTITY = 'StudentProgress';
  const rows = Array.isArray(res.body?.data) ? res.body.data : [];
  const meta = res.body?.meta;

  console.log(`${ENTITY}: ${rows.length} of ${meta?.total ?? '?'} records (page ${meta?.page ?? '?'}/${meta?.totalPages ?? '?'})`);

  const bulk = rows.filter((row) => (row.entityId ?? '').startsWith('recalculate:'));
  if (bulk.length) console.log(`  note: ${bulk.length} bulk recalculation row(s) use a synthetic entityId of recalculate:<count>`);

  rows.forEach((row) => {
    const changes = row.oldValues || row.newValues ? ' [before/after recorded]' : '';
    console.log(`  ${row.action.padEnd(11)} ${String(row.entityId ?? '(no entityId)').padEnd(40)} ${row.createdAt}${changes}`);
  });
  if (!rows.length) console.log(`  -> no ${ENTITY} records; run the matching /class/* request first`);

  if (meta && meta.total > rows.length) {
    console.log(`  -> ${meta.total - rows.length} more record(s) on later pages; increase page`);
  }

  const newest = rows[0];
  if (newest) {
    bru.setVar('latestStudentProgressAuditId', newest.id);
    bru.setVar('latestStudentProgressAuditEntityId', newest.entityId);
  }
}

settings {
  encodeUrl: true
  timeout: 0
}
