meta {
  name: Mail - Send
  type: http
  seq: 2
}

post {
  url: {{base-url}}/mail/send
  body: json
  auth: none
}

body:json {
  {
    "to": "user@example.com",
    "template": "welcome",
    "variables": {
      "name": "John",
      "email": "john@example.com"
    }
  }
}

settings {
  encodeUrl: true
  timeout: 0
}

